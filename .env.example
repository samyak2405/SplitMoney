# =========================
# Shared infra credentials
# =========================
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
REDIS_PASSWORD=
KONG_DB_PASSWORD=change-me-kong-db-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# =========================
# Service database config
# =========================
AUTH_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=authdb
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=change-me-auth-db-password

SPLITWISE_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=splitmoney
SPLITWISE_DB_USERNAME=postgres
SPLITWISE_DB_PASSWORD=change-me-splitwise-db-password

NOTIFICATION_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=notificationdb
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password

PAYMENT_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=paymentdb
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=change-me-payment-db-password

# =========================
# Notification email config
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# =========================
EMAIL_PROVIDER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# =========================
# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set Authorised JavaScript origins: http://localhost:5173
# Set Authorised redirect URIs:      http://localhost:5173
# =========================
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# =========================
# Frontend env vars (Vite)
# VITE_GOOGLE_CLIENT_ID must match GOOGLE_OAUTH_CLIENT_ID above
# =========================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173
VITE_USE_DOCKER_AUTH_UPSTREAM=true

# =========================
# Chat service (Cassandra + Kafka + Redis + WebSocket)
# =========================
CHAT_SERVICE_PORT=8085
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=chatdb
CASSANDRA_DC=datacenter1
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend chat env vars
VITE_CHAT_BASE_URL=/api/chat
VITE_CHAT_WS_URL=ws://localhost:8085/ws-chat

# =========================
# =========================
# Document service (file storage)
# =========================
DOCUMENT_SERVICE_PORT=8084
DOCUMENT_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=documentdb
DOCUMENT_DB_USERNAME=postgres
DOCUMENT_DB_PASSWORD=change-me-document-db-password
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=10
# S3 (production only)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend document env vars
VITE_DOCS_BASE_URL=/api/docs

# =========================
# Frontend/auth integration
# =========================
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================
# AI service (Splity AI)
# AI_PROVIDER: "claude" (default) or "openai"
# Claude: get key at https://console.anthropic.com
# OpenAI: get key at https://platform.openai.com/api-keys
# SPLITY_BOT_USER_ID: a fixed UUID for the Splity bot user (must be pre-inserted into the users table)
# =========================
AI_DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres?currentSchema=aidb
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=change-me-ai-db-password
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=claude
SPLITY_BOT_USER_ID=00000000-0000-0000-0000-000000000099

# =========================
# Langfuse (LLM observability) — http://localhost:3002
# Generate stable keys (e.g. openssl rand -hex 32) and keep them consistent
# Public/secret keys must match LANGFUSE_INIT_PROJECT_PUBLIC/SECRET_KEY so the
# ai-service can authenticate to the pre-seeded project.
# =========================
LANGFUSE_DB_PASSWORD=change-me-langfuse-db-password
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret-32-chars
LANGFUSE_SALT=change-me-salt-32-chars
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@splitmoney.ai
LANGFUSE_INIT_USER_PASSWORD=change-me-langfuse-admin-password
LANGFUSE_URL=http://localhost:3002
